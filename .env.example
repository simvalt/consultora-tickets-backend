# Copia a .env (no se versiona). Sirve para docker compose y para ejecutar el backend fuera de Docker.
# TODOS los valores de abajo son SOLO para desarrollo local; en producción define los tuyos.

# ---- Entorno ----
APP_ENV=local

# ---- Rutas de los repositorios hermanos (relativas a este repo) ----
DATABASE_REPO_PATH=../consultora-tickets-database
FRONTEND_REPO_PATH=../consultora-tickets-frontend

# ---- PostgreSQL (docker compose) ----
POSTGRES_USER=tickets
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=tickets
POSTGRES_PORT=5432

# ---- Puertos publicados en 127.0.0.1 ----
BACKEND_PORT=8000
FRONTEND_PORT=4200

# ---- Administrador inicial (seed base; mínimo 12 caracteres) ----
ADMIN_EMAIL=admin@consultora.local
ADMIN_PASSWORD=Admin#Local1234
ADMIN_NAME=Administrador
# Contraseña de los usuarios demo (solo perfil «demo», solo local)
DEMO_PASSWORD=Demo#Local1234

# ---- Backend ----
# Genera uno propio: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-local-only-change-me-local-only
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# true cuando se sirve por HTTPS (producción detrás de Cloudflare); false en http://localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Orígenes permitidos (CORS) separados por comas. Vacío = mismo origen (recomendado: el nginx del frontend hace proxy de /api)
CORS_ORIGINS=
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
DOCS_ENABLED=true
# Proxies de confianza para X-Forwarded-* (uvicorn). En producción restringe a la IP/red del proxy.
FORWARDED_ALLOW_IPS=*

# ---- Solo para ejecutar el backend FUERA de Docker (pytest, uvicorn local) ----
DATABASE_URL=postgresql://tickets:change_me_local@127.0.0.1:5432/tickets
TEST_DATABASE_URL=postgresql://tickets:change_me_local@127.0.0.1:5432/tickets_test
