# Variables de la DEMO pública (docker-compose.demo.yml). Copia a .env.demo (no se versiona) y rellena.
# Ninguno de estos valores puede ser el de ejemplo: el backend y los seeds se niegan a arrancar con ellos.

# Rutas de los repos hermanos
DATABASE_REPO_PATH=../consultora-tickets-database

# PostgreSQL (sólo accesible dentro de Docker). Genera una: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=tickets
POSTGRES_PASSWORD=
POSTGRES_DB=tickets

# Secreto de firma de tokens (>= 32 caracteres): python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Administrador inicial y contraseña de los usuarios demo (supervisor@, agente1@... @consultora.local).
# Mínimo 12 caracteres; NO uses las de .env.example (son públicas en el README).
ADMIN_EMAIL=admin@consultora.local
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
DEMO_PASSWORD=

# Origen exacto del frontend en Firebase (con https, sin barra final). Se pueden añadir varios separados por comas.
CORS_ORIGINS=https://tickets.sivalt.com

# Token del túnel: Cloudflare Zero Trust → Networks → Tunnels → (tu túnel) → «Install connector» → token.
CLOUDFLARE_TUNNEL_TOKEN=

# Opcional: true para mostrar /api/docs durante la demo
DOCS_ENABLED=false
